# Зависимости — ставятся командой npm install, хранить в репозитории не нужно (сотни МБ).
node_modules/

# Результат сборки (npm run build) — генерируется заново из исходников, в репозитории не нужен.
dist/

# Файлы с переменными окружения — могут содержать реальные адреса/ключи бэкенда.
# .env.example (шаблон без секретов) НЕ попадает под это правило и коммитится как есть.
.env
.env.local

# Файлы логов (если какой-то инструмент их создаёт рядом с проектом).
*.log

# Системный файл macOS (на Windows не появляется, но не мешает оставить на будущее,
# если кто-то из команды будет работать с Mac).
.DS_Store

# Папка с данными локально запущенного PocketBase (база данных бэкенда).
# Если это не игнорировать, в репозиторий попадёт сама база данных с тестовыми
# записями пользователей — это и большой объём, и бессмысленные данные для коммита.
pb_data/

# Настройки редактора VS Code — у каждого разработчика команды они свои
# (цветовая схема, личные привычки). Строка "!.vscode/extensions.json" — исключение
# из исключения: этот конкретный файл (список рекомендуемых расширений для всей
# команды) наоборот стоит хранить в репозитории.
.vscode/*
!.vscode/extensions.json

# Файл полной выгрузки кода проекта для передачи ИИ — техническая служебная вещь,
# не часть исходного кода игры.
dump.txt
dump.ps1